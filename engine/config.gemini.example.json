{
  "server_url": "https://excel2.bcsrp.ir/ai_api.php",
  "worker_token": "PASTE_TOKEN_FROM_WEB_PANEL",
  "provider": "gateway",
  "provider_strategy": "cloud_only",
  "ollama_url": "http://127.0.0.1:11434",
  "chat_model": "unused-local-model",
  "fast_model": "unused-local-model",
  "agent_model": "unused-local-model",
  "analysis_model": "unused-local-model",
  "cloud_provider": {
    "enabled": true,
    "name": "gemini",
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "api_key": "env:GEMINI_API_KEY",
    "chat_model": "gemini-3.8-flash",
    "fast_model": "gemini-3.8-flash",
    "agent_model": "gemini-3.8-flash",
    "analysis_model": "gemini-3.8-flash",
    "allowed_models": ["gemini-3.8-flash", "gemini-3.6-flash", "gemini-3.5-flash-lite"],
    "timeout_seconds": 150,
    "extra_headers": {}
  },
  "cursor_cloud_agent": {
    "enabled": true,
    "api_key": "env:CURSOR_API_KEY",
    "api_base": "https://api.cursor.com",
    "default_model": "composer-2.5",
    "allowed_models": ["composer-2.5", "claude-sonnet-5-5", "grok-4.7", "gemini-3.8-flash"],
    "env_type": "cloud",
    "repos": [],
    "poll_timeout_seconds": 420,
    "poll_interval_seconds": 2.0
  },
  "xai_provider": {
    "enabled": true,
    "name": "grok",
    "base_url": "https://api.x.ai/v1",
    "api_key": "env:XAI_API_KEY",
    "chat_model": "grok-4.7",
    "fast_model": "grok-4.20-0309-non-reasoning",
    "agent_model": "grok-4.7",
    "analysis_model": "grok-4.7",
    "allowed_models": ["grok-4.7", "grok-4.6", "grok-4.20-0309-reasoning", "grok-build-0.1"],
    "timeout_seconds": 180,
    "extra_headers": {}
  },
  "node_uid": "laptop-gen9-gemini-01",
  "node_name": "Windows-Laptop-Gemini",
  "capabilities": ["llm.gemini", "llm.cursor", "llm.grok"],
  "poll_seconds": 8,
  "lease_seconds": 900,
  "max_tool_rounds": 8,
  "request_timeout_seconds": 900,
  "rag_enabled": false,
  "api_retry_attempts": 3,
  "latency_budgets_seconds": {
    "deterministic": 5, "read_model": 150, "action": 150, "deep": 240, "fallback": 150
  }
