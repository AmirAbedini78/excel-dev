# Copy this file to engine/.env.cursor and paste your key from:
#   https://cursor.com/dashboard → Integrations / API Keys
#
# Never commit engine/.env.cursor (it is listed in .gitignore).
#
# For Python SDK / tooling that reads the env var directly:
#   CURSOR_API_KEY=your_key_here

CURSOR_API_KEY=REPLACE_WITH_YOUR_CURSOR_API_KEY
