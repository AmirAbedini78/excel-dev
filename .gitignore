# Local runtime config created by install.php
app/config.php

# Runtime files
storage/logs/*.log
storage/imports/*
storage/exports/*
storage/cache/**
!storage/cache/.htaccess
!storage/cache/.gitkeep

# Keep folders in Git
!storage/logs/.gitkeep
!storage/imports/.gitkeep
!storage/exports/.gitkeep

# Local Playwright / npm install debris
node_modules/

# OS/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

_backup_before_accounting_v2_*/
accounting_v3_patch/
_backup_before_accounting_v3_*/
accounting_v3_1_patch/

# Local AI engine secrets and generated data
engine/config.json
engine/data/
engine/.venv/
**/__pycache__/

# Ephemeral local UAT dumps (permanent tracked evidence under browser/ stays committed)
docs/ai/rc1/evidence/browser/_tmp_*
docs/ai/rc1/evidence/browser/_http_*
docs/ai/rc1/evidence/browser/_analyze_tmp_*
docs/ai/rc1/evidence/browser/_bootstrap_check.php
docs/ai/rc1/evidence/browser/_debug_auth_pages.py
docs/ai/rc1/evidence/browser/_session_rerun.txt
docs/ai/rc1/evidence/lane_c_release_gate.log
docs/ai/rc1/evidence/release_gate_closure*.log

# Optional cloud-only Worker secret config
engine/config.cloud.json

# Gemini runtime secrets, must not be committed
engine/config.gemini.json
engine/.env.gemini

# Cursor API key for local scripts / future integrations (never commit)
engine/.env.cursor

# x.ai / Grok API key (never commit)
engine/.env.xai
